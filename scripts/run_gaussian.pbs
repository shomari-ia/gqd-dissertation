#!/bin/bash
#PBS -S /bin/bash
#PBS -q workq
#PBS -l nodes=1:ppn=16
#PBS -l mem=32gb
#PBS -l walltime=48:00:00
#PBS -l cput=768:00:00
#PBS -j oe
#
# run_gaussian.pbs — unified Gaussian 16 submission script for Maple.
#
# Submit from the repository root:
#
# qsub -N cooh_gqd_pm6 \
#   -v RUN_ID=PM6-COOH-GQD-001,INPUT=calculations/phase1_dft/pm6/inputs/cooh_gqd_pm6_opt_v01.com \
#   scripts/run_gaussian.pbs
#
# Resources may be overridden at submission:
#
# qsub -N cooh_gqd_pm6 \
#   -l nodes=1:ppn=8 \
#   -l mem=8gb \
#   -l walltime=04:00:00 \
#   -v RUN_ID=PM6-COOH-GQD-001,INPUT=calculations/phase1_dft/pm6/inputs/cooh_gqd_pm6_opt_v01.com \
#   scripts/run_gaussian.pbs

set -euo pipefail

cd "${PBS_O_WORKDIR:?Submit the job with qsub from the repository root.}"
REPO_DIR="$PWD"

: "${INPUT:?Pass -v INPUT=path/to/input.com}"
: "${RUN_ID:?Pass -v RUN_ID=STAGE-SYSTEM-NNN}"

if [[ ! -f "$INPUT" ]]; then
    echo "ERROR: Gaussian input file not found: $INPUT" >&2
    exit 2
fi

STAGE_DIR="$(dirname "$(dirname "$INPUT")")"
BASE="$(basename "$INPUT")"
BASE="${BASE%.com}"
BASE="${BASE%.gjf}"

OUTPUT="archive/logs/${BASE}.log"
PROV="${STAGE_DIR}/prov/${RUN_ID}.prov"

mkdir -p \
    archive/logs \
    archive/chk \
    "${STAGE_DIR}/prov" \
    "${STAGE_DIR}/summaries"

# --------------------------------------------------------- Gaussian scratch

SCRDIR="/tmp/${USER}.${PBS_JOBID}"
mkdir -p "$SCRDIR"
export GAUSS_SCRDIR="$SCRDIR"
export OMP_NUM_THREADS=1

cleanup() {
    rm -rf "$SCRDIR"
}
trap cleanup EXIT

ulimit -s unlimited

# ------------------------------------------------ node-specific Gaussian build

EXEC_HOST="$(hostname)"
echo "Execution host: $EXEC_HOST"

if [[ "$EXEC_HOST" =~ cn([0-9]{3}) ]]; then
    NODE_NUMBER="${BASH_REMATCH[1]}"
    NODE_NUMBER=$((10#$NODE_NUMBER))

    if (( NODE_NUMBER <= 29 )); then
        export g16root="/usr/local/apps/gaussian/g16-c01-avx"
        GAUSSIAN_BUILD="g16-c01-avx"
    else
        export g16root="/usr/local/apps/gaussian/g16-c01-avx2"
        GAUSSIAN_BUILD="g16-c01-avx2"
    fi
else
    echo "ERROR: Job is not running on a recognized Maple compute node." >&2
    exit 3
fi

# Gaussian's legacy profile references optional variables and may return a
# nonzero status during normal environment setup. Temporarily disable both
# nounset and errexit while sourcing it, then restore strict Bash mode.
set +e
set +u
# shellcheck disable=SC1091
. "$g16root/g16/bsd/g16.profile"
GAUSSIAN_PROFILE_RC=$?
set -u
set -e

echo "Gaussian profile return code: $GAUSSIAN_PROFILE_RC"

if ! command -v g16 >/dev/null 2>&1; then
    echo "ERROR: g16 was not found after loading $GAUSSIAN_BUILD." >&2
    exit 4
fi

# ------------------------------------------------------------- provenance

{
    echo "run_id=${RUN_ID}"
    echo "date=$(date --iso-8601=seconds)"
    echo "input_file=${INPUT}"
    echo "output_file=${OUTPUT}"
    echo "job_script=scripts/run_gaussian.pbs"
    echo "job_id=${PBS_JOBID:-NA}"
    echo "queue=${PBS_QUEUE:-workq}"
    echo "execution_host=${EXEC_HOST}"
    echo "node_file=${PBS_NODEFILE:-NA}"
    echo "gaussian_build=${GAUSSIAN_BUILD}"
    echo "g16root=${g16root}"
    echo "gaussian_path=$(command -v g16)"
    echo "scratch_directory=${GAUSS_SCRDIR}"
    echo "omp_num_threads=${OMP_NUM_THREADS}"
    echo "hostname=$(hostname)"
    echo "repository_directory=${REPO_DIR}"
    echo "runtime_directory=$(pwd)"
    echo "git_commit=${GIT_COMMIT:-NA}"
    echo "git_dirty=${GIT_DIRTY:-UNKNOWN}"
    echo "input_sha256=$(sha256sum "$INPUT" | awk '{print $1}')"
    echo "start_time=$(date --iso-8601=seconds)"
    } > "$PROV"

# ------------------------------------------------------------------- run

set +e
g16 < "$INPUT" > "$OUTPUT"
GAUSSIAN_EXIT=$?
set -e

echo "gaussian_exit=${GAUSSIAN_EXIT}" >> "$PROV"
echo "end_time=$(date --iso-8601=seconds)" >> "$PROV"

if [[ -f "$OUTPUT" ]]; then
    echo "output_sha256=$(sha256sum "$OUTPUT" | awk '{print $1}')" >> "$PROV"
else
    echo "output_sha256=NA" >> "$PROV"
fi

# --------------------------------------------------------------- QC gate

set +e
scripts/verify_gaussian.sh "$OUTPUT" "${STAGE_DIR}/summaries"
QC_EXIT=$?
set -e

echo "qc_exit=${QC_EXIT}" >> "$PROV"

# The provenance and QC files are retained even if Gaussian fails.
# Return failure to PBS when either Gaussian or the QC gate fails.

if (( GAUSSIAN_EXIT != 0 )); then
    exit "$GAUSSIAN_EXIT"
fi

exit "$QC_EXIT"










