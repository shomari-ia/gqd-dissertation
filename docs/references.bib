  date = {2015-01},
  journaltitle = {Nanomedicine: Nanotechnology, Biology, and Medicine},
  shortjournal = {Nanomedicine},
  volume = {11},
  number = {1},
  eprint = {25131339},
  eprinttype = {pubmed},
  pages = {109--118},
  issn = {1549-9642},
  doi = {10.1016/j.nano.2014.08.001},
  abstract = {We report use of PEG-DSPE coated oxidized graphene nanoribbons (O-GNR-PEG-DSPE) as agent for delivery of anti-tumor drug Lucanthone (Luc) into Glioblastoma Multiformae (GBM) cells targeting base excision repair enzyme APE-1 (Apurinic endonuclease-1). Lucanthone, an endonuclease inhibitor of APE-1, was loaded onto O-GNR-PEG-DSPEs using a simple non-covalent method. We found its uptake by GBM cell line U251 exceeding 67\% and 60\% in APE-1-overexpressing U251, post 24h. However, their uptake was \textasciitilde 38\% and 29\% by MCF-7 and rat glial progenitor cells (CG-4), respectively. TEM analysis of U251 showed large aggregates of O-GNR-PEG-DSPE in vesicles. Luc-O-GNR-PEG-DSPE was significantly toxic to U251 but showed little/no toxicity when exposed to MCF-7/CG-4 cells. This differential uptake effect can be exploited to use O-GNR-PEG-DSPEs as a vehicle for Luc delivery to GBM, while reducing nonspecific cytotoxicity to the surrounding healthy tissue. Cell death in U251 was necrotic, probably due to oxidative degradation of APE-1.},
  langid = {english},
  pmcid = {PMC4280300},
  keywords = {Animals,Apurinic endonuclease-1,Brain Neoplasms,Cell Line Tumor,CG-4,Coculture Techniques,DNA-(Apurinic or Apyrimidinic Site) Lyase,Drug Delivery Systems,Flow Cytometry,GBM,Glioblastoma,Graphene nanoribbons,Graphite,Humans,Hydrogen-Ion Concentration,Lucanthone,Mice,Microscopy Electron Transmission,Nanotubes Carbon,Neoplasm Transplantation,Neuroglia,Oxygen,Rat glial progenitor cells,Rats,Stem Cells,Thioxanthenones},
